@echo off
REM ==========================================================================
REM  MANEKIN FASHION サーバー起動用バッチファイル (start_server.bat)
REM  ・上の「@echo off」により、コマンド文自体を画面に垂れ流さず見やすく表示します
REM  ・ダブルクリックだけで Python (Flask) + MySQL バックエンドを起動できます
REM ==========================================================================

REM 日本語が文字化けしないように、コンソールの文字コードを UTF-8 (65001) に切り替えます（> nul で変更通知を隠します）
chcp 65001 > nul

REM 見出し上部の区切り線をコンソール画面に表示します
echo ========================================================
REM 起動中のサーバー名（MANEKIN FASHION API & MySQL サーバー）を画面に表示します
echo  MANEKIN FASHION - バックエンド API & MySQL サーバー起動
REM 見出し下部の区切り線をコンソール画面に表示します
echo ========================================================
REM 読みやすくするため画面に1行の空行を出力します
echo.
REM 事前に XAMPP の MySQL を起動しておく必要があることを案内表示します
echo ※ 事前に XAMPP Control Panel で「MySQL」がStartになっていることをご確認ください。
REM 起動後にブラウザでアクセスするサーバーURL（http://127.0.0.1:8080）を表示します
echo 接続URL: http://127.0.0.1:8080
REM もう1行の空行を出力して区切ります
echo.

REM このバッチファイル自身が置かれているフォルダ（%~dp0）へドライブごと移動します
cd /d "%~dp0"

REM Python を使って Web サーバー本体（app.py）を起動します（Ctrl+C までここで待機します）
python app.py

REM もし直前の python 実行がエラー終了（終了コードが 0 以外）だった場合の後処理を開始します
if %ERRORLEVEL% NEQ 0 (
    REM エラーメッセージの前に1行空行を入れます
    echo.
    REM サーバー起動に失敗した旨のエラー案内をコンソールに表示します
    echo [!] サーバーの起動に失敗しました。必要なライブラリがインストールされているか確認してください。
    REM 不足ライブラリがある場合のインストールコマンド例（pip install ...）を画面に表示します
    echo pip install flask flask-cors pymysql
)

REM ウィンドウがいきなり閉じてエラーメッセージが読めなくなるのを防ぐため、キー入力待ちで停止します
pause
