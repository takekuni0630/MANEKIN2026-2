@echo off
REM 上の「@echo off」は、これから実行するコマンド自体を黒い画面に表示させず、結果だけ見やすくする設定です
REM 次の「chcp 65001 > nul」で、文字コードをUTF-8（日本語が文字化けしない形式）に変更し、その変更結果メッセージは画面に出さず捨てています
chcp 65001 > nul
REM 画面に飾り用の区切り線（===）を表示します
echo ========================================================
REM 画面にサーバー起動中であることを知らせるタイトルを表示します
echo  MANEKIN FASHION - バックエンド API & MySQL サーバー起動
REM 下側の区切り線（===）を表示します
echo ========================================================
REM 「echo.」は、画面に空行（1行分のすき間）を表示して読みやすくする命令です
echo.
REM 事前にXAMPP（ザンプ）でMySQL（データベース）を起動しておくよう案内メッセージを表示します
echo ※ 事前に XAMPP Control Panel で「MySQL」がStartになっていることをご確認ください。
REM サーバーが起動したあと、ブラウザで開くURL（住所）を表示します
echo 接続URL: http://127.0.0.1:8080
REM 見やすくするために再び空行を1行表示します
echo.
REM 「cd /d "%~dp0"」は、このバッチファイル自身が置かれているフォルダへ現在の作業場所を移動する命令です
cd /d "%~dp0"
REM Pythonを使ってバックエンドプログラム「app.py」を実行し、Webサーバーを立ち上げます
python app.py
REM 直前の「python app.py」でエラーが発生した場合（終了コード ERRORLEVEL が 0 以外のとき）に以下のブロックを実行します
if %ERRORLEVEL% NEQ 0 (
    REM エラー表示の前に空行を1行入れます
    echo.
    REM サーバー起動に失敗した原因として、必要なPythonライブラリ不足の可能性を表示します
    echo [!] サーバーの起動に失敗しました。必要なライブラリがインストールされているか確認してください。
    REM 足りないライブラリをインストールするためのコマンド例を画面に表示します
    echo pip install flask flask-cors pymysql
REM if文（エラー時の分岐）の終わりを示す閉じカッコです
)
REM ユーザーが何かキーを押すまで黒い画面が勝手に閉じないように待機します
pause
