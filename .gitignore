# ==============================================================================
#  Git 除外設定ファイル (.gitignore)
#  Git でバージョン管理（追跡・コミット）しない一時ファイルや環境フォルダを指定します
# ==============================================================================

# Python が実行高速化のために自動生成するキャッシュフォルダを Git 管理から除外します
__pycache__/
# Python コンパイル済みバイトコード（.pyc / .pyo / .pyd）を除外します
*.py[cod]
# 動的生成される pyclass キャッシュファイルを除外します
*$py.class
# C拡張の共有ライブラリファイル（.so）を除外します
*.so

# パスワード等の機密情報を書く .env ファイルは Git に上げないよう除外します
.env
# ローカル専用の Python 仮想環境フォルダ（.venv）を除外します
.venv
# 仮想環境フォルダ（env/）を除外します
env/
# 仮想環境フォルダ（venv/）を除外します
venv/
# 仮想環境フォルダ（ENV/）を除外します
ENV/

# macOS の Finder がフォルダごとに自動作成する隠し設定ファイルを除外します
.DS_Store
# Windows が画像プレビューのキャッシュとして作成する隠しファイルを除外します
Thumbs.db
# Windows がフォルダ表示設定用に作成する隠しファイルを除外します
desktop.ini
